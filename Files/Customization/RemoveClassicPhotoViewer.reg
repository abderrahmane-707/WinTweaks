Windows Registry Editor Version 5.00

; Remove Photo Viewer from Registered Applications
[HKEY_LOCAL_MACHINE\SOFTWARE\RegisteredApplications]
"Windows Photo Viewer"=-

; Remove the Capabilities key entirely
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities]

; Remove the whole photoviewer.dll Applications entry
[-HKEY_CLASSES_ROOT\Applications\photoviewer.dll]

; Remove all PhotoViewer.FileAssoc.* ProgIDs
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Jpeg]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.JFIF]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Png]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Gif]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Bitmap]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Tiff]
[-HKEY_CLASSES_ROOT\PhotoViewer.FileAssoc.Wdp]

; Remove the Image Preview verb from generic image file associations
[-HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\Image Preview]
